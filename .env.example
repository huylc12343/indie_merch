# Choose postgres (recommended), mock, or directus for the product catalog.
MERCH_DATA_SOURCE=postgres
DATABASE_URL=postgresql://indie_merch:indie_merch_dev@localhost:5433/indie_merch

# Admin access for /admin. Use unique values outside local development.
ADMIN_PASSWORD=change-this-local-admin-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Demo checkout: QR is shown after 3 seconds and the order is marked paid 3 seconds later.
PAYMENT_SIMULATION=true
PAYMENT_ACCOUNT_NAME=INDI MERCH DEMO
PAYMENT_ACCOUNT_NUMBER=DEMO-0000
PAYMENT_BANK_BIN=DEMO

# Required only when MERCH_DATA_SOURCE=directus.
DIRECTUS_URL=https://your-directus.example.com
DIRECTUS_TOKEN=
